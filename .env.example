POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_URL=postgresql+psycopg://argus:replace-with-a-unique-local-password@postgres:5432/argus
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=argus-local
S3_SECRET_KEY=replace-with-a-unique-local-secret
S3_BUCKET=argus-evidence
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MAX_UPLOAD_BYTES=26214400
MAX_USER_STORAGE_BYTES=1073741824
MAX_USER_DOCUMENTS=1000
MINIO_ROOT_USER=argus-local
MINIO_ROOT_PASSWORD=replace-with-a-unique-local-secret
JWT_SECRET_KEY=replace-with-a-64-character-random-secret-before-running
JWT_ISSUER=argus-api
JWT_AUDIENCE=argus-web
COOKIE_SECURE=false
APP_ENV=development
ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
AUTH_RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
